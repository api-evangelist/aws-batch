          "docs": "Submit a job"
        },
        {
          "info": {
            "name": "List jobs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://batch.{region}.amazonaws.com/v1/listjobs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List jobs"
        },
        {
          "info": {
            "name": "Describe jobs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://batch.{region}.amazonaws.com/v1/describejobs",
